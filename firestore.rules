rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 開発用: 全許可 =====
    // 本番デプロイ前に下の「本番用ルール」に切り替えること
    match /{document=**} {
      allow read, write: if true;
    }

    // ===== 本番用ルール (上の全許可を削除してこちらを有効化) =====
    // Firebase Authentication でログイン済みユーザーのみ読み書き可能
    //
    // match /offices/{id}    { allow read: if request.auth != null; allow write: if false; }
    // match /staffs/{id}     { allow read: if request.auth != null; allow write: if false; }
    // match /patients/{id}   { allow read: if request.auth != null; allow write: if false; }
    // match /schedules/{id}  { allow read, write: if request.auth != null; }
    // match /settings/{id}   { allow read, write: if request.auth != null; }
  }
}
